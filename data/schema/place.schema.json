{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/egymuseums/egymuseums-data/data/schema/place.schema.json",
  "$comment": "Schema version 1.1 (2026-10-04), additive over 1.0: prices.status; prices.tiers[].onlineAmount; prices.extras[].audience/group/onlineAmount; split-session convention documented on dayHours. Every 1.0 record is valid 1.1; v1/meta.json keeps schemaVersion 1 and adds schemaMinor 1.",
  "title": "EgyMuseums place (schema v1.1)",
  "description": "One museum or archaeological / heritage site in Egypt. Identity and coordinates come from Wikidata (CC0); every hours / price figure must be backed by an entry in `sources`.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "governorate",
    "tier",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case slug, unique across all places."
    },
    "kind": {
      "enum": [
        "museum",
        "site"
      ]
    },
    "wikidataId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^Q[1-9][0-9]*$"
    },
    "name": {
      "$ref": "#/$defs/localizedRequired"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "category": {
      "enum": [
        "pharaonic",
        "greco-roman",
        "coptic",
        "islamic",
        "jewish",
        "modern-art",
        "royal-palace",
        "military",
        "science-natural",
        "specialised",
        "children",
        "mixed"
      ]
    },
    "operator": {
      "enum": [
        "mota-sca",
        "ministry-of-culture",
        "defense",
        "interior",
        "transport",
        "agriculture",
        "university",
        "private",
        "other",
        "unknown"
      ]
    },
    "governorate": {
      "$ref": "#/$defs/governorate"
    },
    "city": {
      "$ref": "#/$defs/localized"
    },
    "area": {
      "$ref": "#/$defs/localized",
      "description": "District / neighbourhood / site area."
    },
    "address": {
      "$ref": "#/$defs/localized"
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 21.5,
      "maximum": 32.0
    },
    "lng": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 24.5,
      "maximum": 37.5
    },
    "status": {
      "enum": [
        "open",
        "closed",
        "renovation",
        "seasonal",
        "unknown"
      ]
    },
    "statusNote": {
      "$ref": "#/$defs/localized"
    },
    "summary": {
      "$ref": "#/$defs/localized"
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/localized"
          },
          "desc": {
            "$ref": "#/$defs/localized"
          },
          "image": {
            "type": "string",
            "description": "Optional photo URL from photos[]"
          }
        }
      }
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dayHours"
          },
          "description": "Regular schedule. Split-session days are written as two (or more) dayHours entries with the same `day`."
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/localized"
              },
              "from": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "$ref": "#/$defs/date"
              },
              "rule": {
                "type": "string",
                "description": "Recurring rule in words or RRULE-like text, e.g. 'Ramadan', 'summer (May-Sep)'."
              },
              "weekly": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dayHours"
                }
              }
            }
          },
          "description": "Real schedule changes only (seasons, Ramadan, closures, special days); visit tips and logistics go in visit.crowdNotes. Ramadan exceptions must carry from/to dates."
        }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "free",
            "unconfirmed"
          ],
          "description": "v1.1. 'confirmed' (the default when tiers exist): tiers are sourced prices; 'free': entry confirmed free; 'unconfirmed': price not confirmed, so no tiers, extras or freeGroups are given and the app shows 'Price not confirmed'."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "audience",
              "group",
              "amount"
            ],
            "properties": {
              "audience": {
                "$ref": "#/$defs/audience"
              },
              "group": {
                "$ref": "#/$defs/group"
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "Standard price: the gate / official portal (egymonuments.gov.eg or venue) price."
              },
              "onlineAmount": {
                "type": "number",
                "minimum": 0,
                "description": "v1.1. Price charged on the official online booking platform, only when it differs from `amount`."
              }
            }
          }
        },
        "usdPegged": {
          "type": "boolean"
        },
        "usdAmount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "extras": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "amount"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/localized"
              },
              "audience": {
                "$ref": "#/$defs/audience",
                "description": "v1.1. Set when the label is for one audience."
              },
              "group": {
                "$ref": "#/$defs/group",
                "description": "v1.1. Set when the label is for one visitor group."
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "onlineAmount": {
                "type": "number",
                "minimum": 0,
                "description": "v1.1. Online booking-platform price, only when it differs from `amount`."
              }
            }
          }
        },
        "freeGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "tickets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onlineUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "platform": {
          "enum": [
            "egymonuments",
            "gem",
            "nmec",
            "onsite",
            "other"
          ]
        },
        "cashAccepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timedEntry": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quickMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "standardMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "deepMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "bestTime": {
          "$ref": "#/$defs/localized"
        },
        "crowdNotes": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "description": "Free-form accessibility flags, e.g. {wheelchair: 'partial', elevator: true}."
    },
    "facilities": {
      "type": "object",
      "description": "Free-form facility flags, e.g. {cafe: true, toilets: true, parking: true}."
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "license"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "social": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egymonuments": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "wikipediaEn": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "wikipediaAr": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "osm": {
          "type": [
            "string",
            "null"
          ],
          "description": "OSM element id like 'node/123', 'way/456' or 'relation/789' (id only, no OSM-derived data)."
        }
      }
    },
    "tier": {
      "enum": [
        "major",
        "notable",
        "minor"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "url",
          "checkedAt"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Which field(s) this source backs, e.g. 'identity', 'coordinates', 'hours', 'prices', 'enumeration'."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "verifiedAt": {
      "$ref": "#/$defs/date"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "curationNote": {
      "type": "string",
      "description": "Internal note for editors; never shown in the app."
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "localizedRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "ar": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dayHours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day"
      ],
      "properties": {
        "day": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "open": {
          "$ref": "#/$defs/time"
        },
        "close": {
          "$ref": "#/$defs/time"
        },
        "lastEntry": {
          "$ref": "#/$defs/time"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "description": "Opening times for one weekday. A day may appear more than once in the same `weekly` array for split sessions (e.g. a morning and an evening session); the app must treat each entry as a separate session for that day."
    },
    "governorate": {
      "enum": [
        "cairo",
        "giza",
        "alexandria",
        "qalyubia",
        "sharqia",
        "dakahlia",
        "gharbia",
        "monufia",
        "beheira",
        "kafr-el-sheikh",
        "damietta",
        "port-said",
        "ismailia",
        "suez",
        "north-sinai",
        "south-sinai",
        "red-sea",
        "matrouh",
        "new-valley",
        "faiyum",
        "beni-suef",
        "minya",
        "asyut",
        "sohag",
        "qena",
        "luxor",
        "aswan"
      ]
    },
    "audience": {
      "enum": [
        "egyptian",
        "foreign",
        "arab-resident",
        "foreign-resident"
      ]
    },
    "group": {
      "enum": [
        "adult",
        "student",
        "child",
        "senior",
        "disabled"
      ]
    }
  }
}
